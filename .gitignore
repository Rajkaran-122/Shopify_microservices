# =============================================================================
# .gitignore — FAANG-Grade E-Commerce Platform
# =============================================================================

# ---- Go Build Artifacts ----
*.exe
*.exe~
*.dll
*.so
*.so.*
*.dylib
*.o
*.a
*.out
*.test

# ---- Go Modules ----
# Keep go.sum committed so builds use verified dependency checksums.
vendor/

# ---- IDE ----
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---- Environment & Secrets ----
# CRITICAL: Never commit secrets (BRD Section 10.3)
.env
.env.local
.env.production
.env.staging
*.pem
*.key
*.crt
*.p12
*.jks

# ---- Terraform ----
.terraform/
*.tfstate
*.tfstate.backup
*.tfplan
.terraform.lock.hcl

# ---- Kubernetes ----
kubeconfig
*.kubeconfig

# ---- Docker ----
.docker/
docker-compose.override.yml

# ---- Database ----
*.sql.bak
*.dump

# ---- Logs ----
*.log
logs/

# ---- Test Artifacts ----
coverage.out
coverage.html
load-test-results.json
test-results/

# ---- Build Output ----
dist/
build/
bin/

# ---- OS-Specific ----
.DS_Store
Thumbs.db
desktop.ini
